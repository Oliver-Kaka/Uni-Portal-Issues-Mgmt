{
  "name": "@helpdesk/server",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "seed:reset": "node src/seed.js --reset",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules node ../../node_modules/jest/bin/jest.js --rootDir . --forceExit"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@helpdesk/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "mongoose": "^8.4.1",
    "sanitize-html": "^2.13.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "extensionsToTreatAsEsm": [".js"],
    "transform": {},
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"]
  }
}
