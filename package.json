{
  "name": "campus-helpdesk",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,green \"npm run dev --workspace=client\" \"npm run dev --workspace=server\"",
    "seed": "npm run seed --workspace=server",
    "seed:reset": "npm run seed:reset --workspace=server",
    "test": "npm run test --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "helmet": "^8.3.0"
  }
}
